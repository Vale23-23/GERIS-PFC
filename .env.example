# ── Hugging Face (dataset upload/download) ──────────────────────────────────
HF_TOKEN=

# ── NASA Earthdata (CAMEL V3 emissivity via earthaccess) ────────────────────
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── Per-machine paths (optional — safe to leave blank) ───────────────────────
# Overrides config.yaml's output_root; lets each machine store downloads on
# a different disk without touching the shared config.
GERIS_OUTPUT_ROOT=

# Redirects goes2go's internal full-disk .nc cache before cropping.
GERIS_GOES2GO_CACHE=

# Shared dataset root read by both worktrees (testing-fdca-real and
# obtencion_imagenes) so they can point at the same physical folder.
GERIS_DATASET_ROOT=

# ── Optional feature flags ───────────────────────────────────────────────────
# Set to 1 to also download GFS TPW during `pipeline.py download`
# (requires cfgrib/eccodes/scipy). Same effect as passing --with-tpw.
GERIS_ENABLE_TPW=

# Copy this file to .env and adjust the values before enabling Comet.
COMET_ENABLED=false
COMET_API_KEY="your-comet-api-key"
COMET_PROJECT_NAME="geris-pfc-ml"
COMET_WORKSPACE="your-workspace"