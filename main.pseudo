    if(
        (bTemp7[i,j]-temp7_bkg_mean>=std_dev_7b_test_threshold and bTemp14-temp14_bkg_mean >= -20)
        or 
        (refl[i,j] -reflb >= std_dev_refelb_max_test_threshold and pass_along_scan_line_test)
    ):
        subpixel_fire_size[i,j] = 0 #hay que definir array antes
        if(350 < fire_temperature[i,j] <= 400):
            fire_temperature[i,j] *= -1
        else:
            fire_temperature[i,j] = -999



